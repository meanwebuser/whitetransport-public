# ── Y Transport Proxy — Environment Configuration ──────────────────────────
# Copy this to .env and fill in your values. NEVER commit .env to git!

# ── Telegram ──────────────────────────────────────────────────────────────
TG_TOKEN_1=
TG_TOKEN_2=
TG_CHAT_ID=
TG_WEBHOOK_SECRET=          # Optional: x-telegram-bot-api-secret-token

# ── VK ────────────────────────────────────────────────────────────────────
VK_TOKEN_1=
VK_TOKEN_2=
VK_PEER_ID=
VK_GROUP_ID=                # Community ID for Callback API
VK_CONFIRMATION_TOKEN=      # Confirmation string for VK Callback
VK_CALLBACK_SECRET=         # Secret key for VK Callback API

# ── OK ────────────────────────────────────────────────────────────────────
OK_TOKEN=
OK_APP_KEY=
OK_APP_SECRET=              # OK session secret for MD5 signing
OK_CHAT_ID=                 # e.g., chat:C12345678901234
OK_RECIPIENT_ID=

# ── Yandex Disk App 1 (Full Disk access) ──────────────────────────────────
YDISK_TOKEN=
YDISK_REFRESH_TOKEN=
YDISK_CLIENT_ID=
YDISK_CLIENT_SECRET=
YDISK_REDIRECT_URI=https://oauth.yandex.ru/verification_code

# ── Yandex Disk App 2 (custom callback) ────────────────────────────────────
YDISK2_CLIENT_ID=
YDISK2_CLIENT_SECRET=
YDISK2_REDIRECT_URI=https://oauth-callback.example.invalid/yandex

# ── VK Browser Bridge ────────────────────────────────────────────────────
VKB_APP_ID=2685278

# ── Vercel / Serverless ─────────────────────────────────────────────────
VERCEL_URL=                 # Auto-set by Vercel, e.g., your-app.vercel.app
BASE_URL=                   # Public URL for webhook registration

# ── Benchmark settings ─────────────────────────────────────────────────
MSG_COUNT=10
MODE=all
PROVIDERS=vk,tg,ok
