{
  "name": "@whitetransport/any-transport",
  "version": "0.1.0",
  "description": "Unified encrypted delay-tolerant transport engine over unreliable provider logs.",
  "main": "dist/core/index.js",
  "types": "dist/core/index.d.ts",
  "private": true,
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./crypto": {
      "types": "./dist/crypto/index.d.ts",
      "default": "./dist/crypto/index.js"
    },
    "./providers": {
      "types": "./dist/providers/index.d.ts",
      "default": "./dist/providers/index.js"
    },
    "./storage": {
      "types": "./dist/storage/index.d.ts",
      "default": "./dist/storage/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "dev": "tsc --project tsconfig.json --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint packages/**/*.ts",
    "test": "jest --config jest.config.js",
    "benchmark": "npx ts-node scripts/benchmark.ts",
    "demo": "npx ts-node scripts/full-demo.ts",
    "bridge": "npx ts-node scripts/bridge-server.ts",
    "start": "npx ts-node scripts/full-demo.ts"
  },
  "dependencies": {
    "@whitetransport/provider-channels": "0.1.0",
    "@whitetransport/video-conference-transport": "0.1.0",
    "better-sqlite3": "^11.0.0",
    "form-data": "^4.0.5",
    "libsodium-wrappers": "^0.7.13",
    "pino": "^9.0.0",
    "ws": "^8.16.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/libsodium-wrappers": "^0.7.14",
    "@types/node": "^20.14.0",
    "@types/ws": "^8.5.10",
    "eslint": "^9.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0"
  },
  "license": "MIT"
}
